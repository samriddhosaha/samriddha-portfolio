# Copy to .env.local for local work (never commit real values). On Vercel set these under Project > Settings > Environment Variables.
# Local dev needs none of them except optionally ADMIN_PASSWORD: with no database URL it uses file:.data/dev.db,
# with no Cloudinary keys uploads go to .data/uploads, and with no Resend key emails are written to .data/outbox.jsonl.

# --- Site ---
SITE_URL=https://samriddha-portfolio.vercel.app      # absolute URLs in RSS, emails, sitemap, OG tags

# --- Database (Turso / libSQL). Created with `turso db create` + `turso db tokens create`, or the Vercel Marketplace integration ---
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- Owner login (single user, no sign-up) ---
# Generate with: npm run hash-password -- "a passphrase of 12+ characters"
ADMIN_PASSWORD_HASH=scrypt:...
# Random 32+ chars, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Rotating it signs everyone out.
SESSION_SECRET=
# Dev/test only. Ignored when NODE_ENV=production (Vercel).
# ADMIN_PASSWORD=change-me-locally

# --- Media (Cloudinary, free tier). Images <= 10 MB and videos <= 100 MB are the free-plan limits too ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend, free tier). The sending domain must be verified, or use onboarding@resend.dev for tests to yourself ---
RESEND_API_KEY=
MAIL_FROM=Samriddha Saha <newsletter@your-domain.example>
# Where "Send test to me" goes. Required before a real send is allowed.
OWNER_EMAIL=you@example.com
