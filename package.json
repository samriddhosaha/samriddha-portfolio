{
  "name": "samriddha-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node dev/server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:qa": "playwright test tests/audit.spec.ts tests/interactions.spec.ts",
    "test:e2e": "playwright test tests/feed.spec.ts",
    "test": "npm run test:unit && playwright test",
    "lh": "node tools/lh-run.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "chrome-launcher": "^1.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.6.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "markdown-it": "^15.0.3",
    "sanitize-html": "2.13.1",
    "zod": "^4.6.7"
  }
}
